# HERD environment configuration example
# Copy this file to .env and adjust paths for your local setup.

# ------------------------------------------------------------------------------
# Data Preprocessing
# ------------------------------------------------------------------------------
# Path to raw upstream datasets required by `pnpm dataset:build`.
# Directory structure must contain:
#   <HERO_TRACE_SOURCE_ROOT>/trace/LLM-CL-Benchmark_500/
#   <HERO_TRACE_SOURCE_ROOT>/trace/LLM-CL-Benchmark_5000/
#   <HERO_TRACE_SOURCE_ROOT>/superni/natural-instructions-v2.8/tasks/
# Upstream source references:
#   - TRACE: https://github.com/BeyonderXX/TRACE (revision pinned in config/datasets/trace-plus-17.json)
#   - SuperNI: https://github.com/allenai/natural-instructions (revision pinned in config/datasets/trace-plus-17.json)
HERO_TRACE_SOURCE_ROOT=/path/to/raw

# ------------------------------------------------------------------------------
# Local DSH Model Route
# ------------------------------------------------------------------------------
# HERO_LOCAL_QWEN_AUTOSTART=1
# HERO_QWEN_LOCAL_API_KEY=local-loopback-only
